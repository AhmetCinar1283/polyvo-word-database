# Kopyalayip `.env` olarak kaydedin. `.env` repoya GIRMEZ.
# Cozumleme sirasi (core/env.py):
#   --api-key > LLM_API_KEY_<PROVIDER> > saglayicinin kendi adi > LLM_API_KEY

# Cloudflare (hem Workers AI metin modelleri hem embedding icin)
CF_ACCOUNT_ID=
CF_API_TOKEN=

GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Yerel / uzak Ollama
OLLAMA_HOST=http://localhost:11434
# Colab tuneli (cloudflared). Ollama 403 vermesin diye tunel
# --http-host-header "localhost:11434" ile acilmali.
COLAB_URL=
